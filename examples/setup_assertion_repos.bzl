"Setup for docker testing"

def _impl_configure_docker(rctx):
    # See if docker_host is set
    has_docker = "DOCKER_HOST" in rctx.os.environ

    # See if standard docker sock exists
    if not has_docker:
        r = rctx.execute(["stat", "/var/run/docker.sock"])
        if r.return_code == 0:
            has_docker = True

    docker_platform = None
    if has_docker:
        # DOCKER_HOST may point to a daemon on a different architecture, such
        # as the amd64 Testcontainers Cloud daemon used by arm64 macOS CI.
        docker = rctx.which("docker")
        if not docker:
            fail("Docker is configured, but its CLI is not on PATH")
        result = rctx.execute([docker, "info", "--format", "{{.OSType}}/{{.Architecture}}"])
        if result.return_code:
            fail("Could not determine the Docker daemon platform: {}".format(result.stderr))
        docker_platform = {
            "linux/amd64": "//examples:linux_amd64",
            "linux/x86_64": "//examples:linux_amd64",
            "linux/arm64": "//examples:linux_arm64",
            "linux/aarch64": "//examples:linux_arm64",
        }.get(result.stdout.strip())
        if not docker_platform:
            fail("Unsupported Docker daemon platform: {}".format(result.stdout.strip()))

    compatible_with = "[]" if has_docker else '["@platforms//:incompatible"]'

    rctx.file("defs.bzl", """
# Generated by configure_docker.bzl
TARGET_COMPATIBLE_WITH = %s
DOCKER_PLATFORM = %s
""" % (compatible_with, repr(docker_platform)))
    rctx.file("BUILD.bazel", 'exports_files(["defs.bzl"])')
    pass

configure_docker = repository_rule(
    implementation = _impl_configure_docker,
    environ = ["DOCKER_HOST", "DOCKER_TLS_VERIFY", "DOCKER_CERT_PATH"],
    local = True,
)
